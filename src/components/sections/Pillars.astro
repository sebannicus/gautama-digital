---
/**
 * Pillars.astro
 * Propósito: Vista rápida de los 3 pilares de servicio.
 * Principio SRP: solo presenta el mapa de servicios — no contiene precios detallados.
 */

import SectionLabel from '../ui/SectionLabel.astro';
import { SITE } from '../../content/site';

const whatsappMsg = encodeURIComponent('Hola Seba, quiero saber qué sistema necesita mi negocio. ¿Podemos hablar?');
const whatsappUrl = `https://wa.me/${SITE.whatsapp}?text=${whatsappMsg}`;

const pillars = [
  {
    num: '01',
    accent: '#04C4D9',
    label: 'Presencia Digital',
    problem: 'Tu negocio no aparece cuando te buscan',
    detail: 'Mientras no estés en Google, existe para tus clientes solo si te recomiendan. CheckVital pasó de cero a #1 Google Maps en 30 días — sin pagar publicidad.',
    outcomes: [
      'Apareces en Google Maps para tus keywords locales',
      'Visitas orgánicas desde el día 30 — $0 en pauta',
      'GA4 mide cada prospecto desde el primer día',
      'El sitio es tuyo: sin mensualidades ni rehenes',
    ],
    priceAnchor: 'Desde $280.000 CLP',
    href: '/servicios',
    cta: 'Ver planes',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
  },
  {
    num: '02',
    accent: '#0477BF',
    label: 'Automatización IA',
    problem: 'Pierdes leads porque no puedes responder 24/7',
    detail: 'Cada hora que tardas en responder, el prospecto se va a la competencia. Un agente IA en producción en Antocarz captura leads con nombre, consulta y contexto — a cualquier hora.',
    outcomes: [
      'Bot WhatsApp IA captura y califica prospectos sin ti',
      'Solo recibes leads listos para cerrar',
      'Instagram con 8 posts al mes publicados automático',
      'Tu tiempo para lo que genera dinero de verdad',
    ],
    priceAnchor: 'Desde $350.000 impl. + $50.000/mes',
    href: '/servicios',
    cta: 'Ver opciones',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
  {
    num: '03',
    accent: '#C4A35A',
    label: 'Inteligencia de Negocios',
    problem: 'Tomas decisiones sin saber qué funciona',
    detail: 'Sin datos, cada peso en marketing es una apuesta. Un CRM + dashboard personalizado te dice cuántos prospectos activos tienes, de dónde vienen y qué canal te genera más retorno.',
    outcomes: [
      'Dashboard con todos tus KPIs en tiempo real',
      'CRM: ningún prospecto se pierde en el camino',
      'Atribución real de cada canal de marketing',
      'Reportes automáticos para decidir con datos',
    ],
    priceAnchor: 'Precio según alcance — diagnóstico gratuito',
    href: '/servicios',
    cta: 'Cotizar proyecto',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  },
];
---

<section class="pillars section" id="sistemas" aria-labelledby="pillars-heading">
  <div class="container">

    <div class="pillars__header" data-scroll-children>
      <SectionLabel text="LOS 3 SISTEMAS" align="center" />
      <h2 class="pillars__title gs-fade-up" id="pillars-heading">
        Un sistema. Tres frentes.<br />
        <span class="text-gradient-gold">Resultados medibles.</span>
      </h2>
      <p class="pillars__sub">
        Muchos clientes comienzan con el primero y escalan a los tres. Cada uno resuelve un problema de crecimiento distinto.
      </p>
    </div>

    <div class="pillars__grid">
      {pillars.map((p, i) => (
        <article
          class="pillar gs-fade-up"
          style={`--p-accent: ${p.accent}; animation-delay: ${i * 80}ms`}
          aria-labelledby={`pillar-heading-${p.num}`}
        >
          <div class="pillar__top">
            <div class="pillar__icon-wrap" aria-hidden="true">
              <Fragment set:html={p.icon} />
            </div>
            <span class="pillar__num" aria-hidden="true">{p.num}</span>
          </div>

          <h3 class="pillar__label" id={`pillar-heading-${p.num}`}>{p.label}</h3>

          <p class="pillar__problem">
            <span class="pillar__problem-prefix">El problema:</span> {p.problem}
          </p>

          <p class="pillar__detail">{p.detail}</p>

          <ul class="pillar__outcomes" aria-label="Qué obtienes">
            {p.outcomes.map(o => (
              <li class="pillar__outcome">
                <svg class="pillar__check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {o}
              </li>
            ))}
          </ul>

          <div class="pillar__footer">
            <span class="pillar__price">{p.priceAnchor}</span>
            <a href={p.href} class="pillar__cta">
              {p.cta}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="pillars__bottom gs-fade-up">
      <p class="pillars__bottom-text">¿No sabes por dónde empezar?</p>
      <a href={whatsappUrl} class="pillars__diagnose" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Diagnóstico gratuito — 30 minutos y te digo exactamente qué necesita tu negocio
      </a>
    </div>

  </div>
</section>

<script>
  import { initScrollReveal } from '../../utils/animations';
  initScrollReveal();
</script>

<style>
  .pillars {
    background: var(--color-bg);
  }

  .pillars__header {
    text-align: center;
    margin-bottom: var(--space-14);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .pillars__title {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-tight);
  }

  .pillars__sub {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 480px;
    line-height: var(--leading-relaxed);
  }

  /* Grid */
  .pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 900px) {
    .pillars__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card */
  .pillar {
    --p-accent: #04C4D9;
    position: relative;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color var(--transition-base), box-shadow var(--transition-slow), transform var(--transition-slow);
    overflow: hidden;
  }

  .pillar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--p-accent);
    opacity: 0.7;
    border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  }

  .pillar::after {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--p-accent) 10%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }

  .pillar:hover {
    border-color: color-mix(in srgb, var(--p-accent) 40%, var(--color-border));
    box-shadow: 0 8px 40px color-mix(in srgb, var(--p-accent) 8%, transparent);
    transform: translateY(-3px);
  }

  /* Top row */
  .pillar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pillar__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--p-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--p-accent) 25%, transparent);
    color: var(--p-accent);
    flex-shrink: 0;
  }

  .pillar__num {
    font-family: var(--font-headline);
    font-size: var(--text-4xl);
    font-weight: var(--weight-extrabold);
    color: var(--p-accent);
    opacity: 0.12;
    line-height: 1;
  }

  /* Label */
  .pillar__label {
    font-family: var(--font-headline);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  /* Problem */
  .pillar__problem {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--p-accent) 6%, transparent);
    border-left: 2px solid color-mix(in srgb, var(--p-accent) 50%, transparent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .pillar__problem-prefix {
    font-weight: var(--weight-semibold);
    color: var(--p-accent);
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  /* Detail */
  .pillar__detail {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* Outcomes */
  .pillar__outcomes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pillar__outcome {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-snug);
  }

  .pillar__check {
    color: var(--p-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Footer */
  .pillar__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .pillar__price {
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
  }

  .pillar__cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-subhead);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--p-accent);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: var(--tracking-wide);
    flex-shrink: 0;
    transition: gap var(--transition-base);
  }

  .pillar__cta:hover {
    gap: var(--space-2);
  }

  /* Bottom CTA */
  .pillars__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .pillars__bottom-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pillars__diagnose {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-3) var(--space-5);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-base), color var(--transition-base);
  }

  .pillars__diagnose:hover {
    border-color: var(--color-gold);
    color: var(--color-text-primary);
  }

  .pillars__diagnose svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }
</style>
